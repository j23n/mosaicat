{
  "name": "atmo",
  "version": "0.0.0",
  "description": "A static site generator for an ATProto repo",
  "license": "BSD-3-Clause",
  "type": "module",
  "bin": {
    "atmo": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && npm run bundle && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "bundle": "esbuild src/client/decrypt.ts --bundle --format=esm --minify --outfile=src/templates/decrypt.js",
    "atmo": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "age-encryption": "^0.3.0",
    "eta": "^4.6.0",
    "marked": "^18.0.7",
    "sanitize-html": "^2.17.6",
    "smol-toml": "^1.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sanitize-html": "^2.16.1",
    "esbuild": "^0.28.1",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
